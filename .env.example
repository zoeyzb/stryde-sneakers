# ─────────────────────────────────────────────────────────────────────────────
# STRYDE storefront configuration. Copy to `.env.local` and fill in.
# Every value is server-only unless it starts with NEXT_PUBLIC_.
# See SETUP.md for where each value comes from.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of this site (used for OAuth redirects, emails and metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Shopify Storefront API (catalogue, cart, checkout) — required ───────────
# Your store's myshopify domain, e.g. stryde.myshopify.com.
# Use `mock.shop` ONLY for local test runs (no credentials, mocked checkout).
SHOPIFY_STORE_DOMAIN=
# Headless channel → Storefront API → private access token (preferred, server-only)
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# …or the public access token if you only have that one.
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-10

# Collection presented as "the current collection" (home + sold-out messaging).
SHOPIFY_CURRENT_COLLECTION_HANDLE=current-collection
# Optional collection previewed on /next-drop.
SHOPIFY_UPCOMING_COLLECTION_HANDLE=next-drop

# ── Shopify Admin API (waitlist storage, restock emails, scripts) ───────────
# Custom app (Dev Dashboard) token with scopes:
#   read_products, write_products, read_inventory, write_inventory,
#   read_customers, write_customers, read_locations
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Defaults to SHOPIFY_STORE_DOMAIN; set if the Admin domain differs.
SHOPIFY_ADMIN_STORE_DOMAIN=
SHOPIFY_ADMIN_API_VERSION=2026-10

# Webhook signing secret (the app's client secret) for /api/webhooks/shopify.
SHOPIFY_WEBHOOK_SECRET=

# ── Shopify Customer Account API (sign-in + order history) — optional ──────
# Headless channel → Customer Account API → client ID. Without these, /account
# links to Shopify's hosted customer account instead.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Only for confidential clients.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
# Numeric shop ID (Settings → Customer accounts URL, shopify.com/<id>/account).
SHOPIFY_SHOP_ID=
SHOPIFY_CUSTOMER_ACCOUNT_API_VERSION=2026-10
# 32+ random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# ── Email (back-in-stock notifications, contact form) — optional ───────────
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "STRYDE <studio@stryde.example>"
EMAIL_FROM=
# Inbox that receives contact-form messages.
STORE_CONTACT_EMAIL=
